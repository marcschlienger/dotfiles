# macOS metadata
.DS_Store

# Editor-generated files
*.swp
*.swo
*~
nvim.log

# Emacs runtime data and installed packages
emacs/.emacs.d/**/*.elc
emacs/.emacs.d/auto-save-list/
emacs/.emacs.d/backup/
emacs/.emacs.d/eln-cache/
emacs/.emacs.d/elpa/
emacs/.emacs.d/elfeed/
emacs/.emacs.d/org-persist/
emacs/.emacs.d/savehist
emacs/.emacs.d/transient/
emacs/.emacs.d/tree-sitter/
# Records the Emacs version that last byte-compiled the packages, so
# early-init can spot an upgrade. Per-machine by definition: sharing one
# value across machines would silence the check on whichever machine
# actually upgraded.
emacs/.emacs.d/emacs-version-stamp

# Vendored Zsh plugins and local history
zsh/.zsh/plugins
zsh/.zsh/histfile
zsh/.zcompdump*
