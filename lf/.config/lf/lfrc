# ----------------------------------------------------------------------------
# Options
# ----------------------------------------------------------------------------
set autoquit true
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg"
set icons
set ifs "\n"
set incsearch
set period 1
set scrolloff 10
set sixel true
set shell zsh
set shellopts "-eu"
set wrapscan
set wrapscroll

set previewer ~/.config/lf/preview

# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------
cmd extract ${{
	set -f
	clear
	printf '%s\n' $fx
    echo '\nExtract file(s)? [y/N]'
	read ans
    [ $ans = 'y' ] && (echo 'Extracting files...' && IFS=':'; atool -x $fx) || (echo 'Cancelled...')
	clear
}}
map x extract

cmd fzf_jump ${{
    res="$(fzf --walker=file,dir,follow,hidden --walker-skip=.git,node_modules,.Trash)"
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            cmd="cd"
        else
            cmd="select"
        fi
        res="$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        lf -remote "send $id $cmd \"$res\""
    fi
}}
map <c-o> :fzf_jump

# ----------------------------------------------------------------------------
# Key Mappings
# ----------------------------------------------------------------------------
map <enter> shell

map <c-n> push :mkdir<space>

map d
map dd cut
map dD delete


map <c-d> set hidden!

map nc cd ~/Nextcloud
