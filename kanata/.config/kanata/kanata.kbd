(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(include common.kbd)

(defsrc
  caps lctl lsft rsft lalt lmet rmet
)

(defalias
  os-lctrl (one-shot-release $oneshot-timeout lalt)
  os-lalt  (one-shot-release $oneshot-timeout lmet)
  os-lmeta (one-shot-release $oneshot-timeout lctl)
  os-rmeta (one-shot-release $oneshot-timeout rctl)
)

(deflayer base
  @os-ctrl @os-lctrl @os-shift @os-rshift @os-lalt @os-lmeta @os-rmeta
)
