(defcfg
  process-unmapped-keys yes
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
  )
)

(include common.kbd)

(defsrc
  caps lctl lsft rsft lalt lmet ralt sys rctl
)

(defalias
  os-lctrl (one-shot-release $oneshot-timeout lalt)
  os-lalt  (one-shot-release $oneshot-timeout lctl)
  os-lmeta (one-shot-release $oneshot-timeout lmet)
  os-ralt  (one-shot-release $oneshot-timeout rctl)
  os-prtsc (one-shot-release $oneshot-timeout rmet)
  os-rctrl ralt
)

(deflayer base
  @os-ctrl @os-lctrl @os-shift @os-rshift @os-lalt @os-lmeta
  @os-ralt @os-prtsc @os-rctrl
)
