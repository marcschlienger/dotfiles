# Solarized Light by Ethan Schoonover, mapped to Zathura roles.
# Text accents are contrast-adjusted for a small UI font.

set default-bg                  "#fdf6e3"
set default-fg                  "#586e75"
set statusbar-bg                "#eee8d5"
set statusbar-fg                "#002b36"
set inputbar-bg                 "#fdf6e3"
set inputbar-fg                 "#006eaa"

set completion-bg               "#eee8d5"
set completion-fg               "#002b36"
set completion-group-bg         "#fdf6e3"
set completion-group-fg         "#586e75"
set completion-highlight-bg     "#93a1a1"
set completion-highlight-fg     "#002b36"

set notification-bg             "#eee8d5"
set notification-fg             "#002b36"
set notification-error-bg       "#eee8d5"
set notification-error-fg       "#b02624"
set notification-warning-bg     "#eee8d5"
set notification-warning-fg     "#7d6000"

set index-bg                    "#fdf6e3"
set index-fg                    "#586e75"
set index-active-bg             "#eee8d5"
set index-active-fg             "#002b36"

set highlight-color             "rgba(181,137,0,0.32)"
set highlight-active-color      "rgba(203,75,22,0.42)"
set highlight-fg                "#002b36"

set render-loading-bg           "#fdf6e3"
set render-loading-fg           "#586e75"
set recolor-lightcolor          "#fdf6e3"
set recolor-darkcolor           "#586e75"

set signature-error-color       "rgba(220,50,47,0.24)"
set signature-success-color     "rgba(133,153,0,0.24)"
set signature-warning-color     "rgba(181,137,0,0.24)"
