# Solarized Dark by Ethan Schoonover, mapped to Zathura roles.
# Text accents are contrast-adjusted for a small UI font.

set default-bg                  "#002b36"
set default-fg                  "#839496"
set statusbar-bg                "#073642"
set statusbar-fg                "#93a1a1"
set inputbar-bg                 "#002b36"
set inputbar-fg                 "#3495df"

set completion-bg               "#073642"
set completion-fg               "#93a1a1"
set completion-group-bg         "#002b36"
set completion-group-fg         "#93a1a1"
set completion-highlight-bg     "#586e75"
set completion-highlight-fg     "#fdf6e3"

set notification-bg             "#073642"
set notification-fg             "#93a1a1"
set notification-error-bg       "#002b36"
set notification-error-fg       "#f45a55"
set notification-warning-bg     "#002b36"
set notification-warning-fg     "#b58900"

set index-bg                    "#002b36"
set index-fg                    "#839496"
set index-active-bg             "#073642"
set index-active-fg             "#93a1a1"

set highlight-color             "rgba(181,137,0,0.38)"
set highlight-active-color      "rgba(203,75,22,0.48)"
set highlight-fg                "#fdf6e3"

set render-loading-bg           "#002b36"
set render-loading-fg           "#839496"
set recolor-lightcolor          "#002b36"
set recolor-darkcolor           "#839496"

set signature-error-color       "rgba(220,50,47,0.30)"
set signature-success-color     "rgba(133,153,0,0.30)"
set signature-warning-color     "rgba(181,137,0,0.30)"
