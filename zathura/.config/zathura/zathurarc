# General settings
# ----------------
set selection-clipboard     clipboard
set statusbar-basename      true
set statusbar-home-tilde    true
set synctex                 true
set synctex-editor-command  nvim
set window-title-basename   true
set window-title-home-tilde true

# Key mappings
# ----------------
map <C-b> feedkeys ":bmark "
map <C-l> feedkeys ":blist "
map <C-k> feedkeys ":bdelete "
map D set "first-page-column 1:1"
map <C-d> set "first-page-column 1:2"

# Layout
# ----------------
set adjust-open             width
set font                    "FiraCode Nerd Font 13"
set statusbar-h-padding     5
set statusbar-v-padding     5

# Theme
# ----------------
set recolor                 false
set recolor-keephue         true
set recolor-reverse-video   true
include themes/current
